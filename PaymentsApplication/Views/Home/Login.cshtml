<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login & Dashboard</title>

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: Arial, Helvetica, sans-serif;
                background: linear-gradient(135deg, #667eea, #764ba2);
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px;
            }

            .container {
                width: 100%;
                max-width: 450px;
            }

            .hidden {
                display: none !important;
            }

            /* =========================
                       LOGIN
                    ========================= */

            .card {
                background: #ffffff;
                padding: 40px;
                border-radius: 16px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.20);
            }

                .card h1 {
                    text-align: center;
                    color: #333;
                    margin-bottom: 8px;
                }

            .subtitle {
                text-align: center;
                color: #777;
                margin-bottom: 30px;
            }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 8px;
                    color: #333;
                    font-weight: 600;
                }

                .form-group input {
                    width: 100%;
                    padding: 14px;
                    border: 1px solid #ddd;
                    border-radius: 8px;
                    font-size: 16px;
                    outline: none;
                    transition: 0.2s;
                }

                    .form-group input:focus {
                        border-color: #667eea;
                        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.10);
                    }

            button {
                width: 100%;
                padding: 14px;
                border: none;
                border-radius: 8px;
                background: #667eea;
                color: white;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
                transition: 0.2s;
            }

                button:hover {
                    background: #5568d8;
                }

                button:disabled {
                    background: #aaa;
                    cursor: not-allowed;
                }

            .error {
                color: #dc3545;
                text-align: center;
                margin-top: 15px;
                font-size: 14px;
            }

            .success {
                color: #198754;
                text-align: center;
                margin-top: 15px;
            }


            /* =========================
                       DASHBOARD
                    ========================= */

            .dashboard {
                background: white;
                border-radius: 16px;
                padding: 30px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.20);
            }

            .dashboard-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
                margin-bottom: 30px;
            }

                .dashboard-header h1 {
                    color: #333;
                    font-size: 26px;
                }

                .dashboard-header p {
                    color: #777;
                    margin-top: 5px;
                }

            .logout-btn {
                width: auto;
                padding: 10px 18px;
                background: #dc3545;
            }

                .logout-btn:hover {
                    background: #c82333;
                }


            /* =========================
                       BALANCE
                    ========================= */

            .balance-card {
                background: linear-gradient( 135deg, #667eea, #764ba2 );
                color: white;
                padding: 30px;
                border-radius: 14px;
                margin-bottom: 25px;
            }

                .balance-card p {
                    font-size: 16px;
                    opacity: 0.9;
                    margin-bottom: 10px;
                }

                .balance-card h2 {
                    font-size: 38px;
                }


            /* =========================
                       ACCOUNT INFORMATION
                    ========================= */

            .user-info {
                border: 1px solid #eee;
                border-radius: 12px;
                padding: 20px;
            }

                .user-info h3 {
                    color: #333;
                    margin-bottom: 15px;
                }

            .info-row {
                display: flex;
                justify-content: space-between;
                padding: 12px 0;
                border-bottom: 1px solid #eee;
                gap: 20px;
            }

                .info-row:last-child {
                    border-bottom: none;
                }

                .info-row span {
                    color: #777;
                }

                .info-row strong {
                    color: #333;
                    word-break: break-word;
                    text-align: right;
                }


    </style>
</head>

<body>


    <!-- ==================================
         LOGIN PAGE
    =================================== -->

    <div class="container"
         id="loginPage">

        <div class="card">

            <h1>Login</h1>

            <p class="subtitle">
                Enter your phone number and password
            </p>


            <form id="loginForm">

                <!-- Phone -->
                <div class="form-group">

                    <label for="phone">
                        Phone Number
                    </label>

                    <input type="tel"
                           id="phone"
                           placeholder="01011111112"
                           autocomplete="tel"
                           required>

                </div>


                <!-- Password -->
                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input type="password"
                           id="password"
                           placeholder="Enter your password"
                           autocomplete="current-password"
                           required>

                </div>


                <!-- Login Button -->
                <button type="submit"
                        id="loginButton">
                    Login
                </button>


                <!-- Error -->
                <div id="errorMessage"
                     class="error"></div>

            </form>

        </div>

    </div>



    <!-- ==================================
         DASHBOARD PAGE
    =================================== -->

    <div class="container hidden"
         id="dashboardPage">

        <div class="dashboard">


            <!-- Dashboard Header -->
            <div class="dashboard-header">

                <div>

                    <h1>
                        Welcome,
                        <span id="username"></span>!
                    </h1>

                    <p>
                        Welcome to your dashboard
                    </p>

                </div>


                <button class="logout-btn"
                        id="logoutButton">
                    Logout
                </button>

            </div>



            <!-- Balance -->
            <div class="balance-card">

                <p>
                    Current Balance
                </p>

                <h2>
                    <span id="balance">
                        0.00
                    </span>
                </h2>

            </div>



            <!-- Account Information -->
            <div class="user-info">

                <h3>
                    Account Information
                </h3>


                <div class="info-row">

                    <span>
                        Phone Number
                    </span>

                    <strong id="dashboardPhone">
                        -
                    </strong>

                </div>


                <div class="info-row">

                    <span>
                        Username
                    </span>

                    <strong id="dashboardUsername">
                        -
                    </strong>

                </div>

            </div>

        </div>

    </div>



    <!-- ==================================
         JAVASCRIPT
    =================================== -->

    <script>

            // ----------------------------------
            // Elements
            // ----------------------------------

            const loginForm =
                document.getElementById("loginForm");

            const loginButton =
                document.getElementById("loginButton");

            const errorMessage =
                document.getElementById("errorMessage");

            const loginPage =
                document.getElementById("loginPage");

            const dashboardPage =
                document.getElementById("dashboardPage");

            const username =
                document.getElementById("username");

            const dashboardUsername =
                document.getElementById("dashboardUsername");

            const dashboardPhone =
                document.getElementById("dashboardPhone");

            const balance =
                document.getElementById("balance");

            const logoutButton =
                document.getElementById("logoutButton");


            // ----------------------------------
            // Login
            // ----------------------------------

            loginForm.addEventListener(
                "submit",
                async function(event) {

                    event.preventDefault();

                    // Clear previous error
                    errorMessage.textContent = "";


                    // Get values
                    const phone =
                        document
                            .getElementById("phone")
                            .value
                            .trim();

                    const password =
                        document
                            .getElementById("password")
                            .value;


                    // Basic validation
                    if (!phone || !password) {

                        errorMessage.textContent =
                            "Please enter phone number and password.";

                        return;
                    }


                    // Disable button
                    loginButton.disabled = true;

                    loginButton.textContent =
                        "Logging in...";


                    try {

                        // ----------------------------------
                        // API Request
                        // ----------------------------------

                        const response = await fetch(
                            "https://localhost:7071/api/users/login",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    Phone: phone,

                                    Pass: password

                                })
                            }
                        );


                        // ----------------------------------
                        // Convert response to JSON
                        // ----------------------------------

                        const data =
                            await response.json();


                        console.log(
                            "API Response:",
                            data
                        );


                        // ----------------------------------
                        // Check Login
                        // ----------------------------------

                        if (data.success === true) {

                            showDashboard(data);

                        } else {

                            errorMessage.textContent =
                                data.message ||
                                "Login failed. Please check your credentials.";

                        }


                    } catch (error) {

                        console.error(
                            "Login Error:",
                            error
                        );


                        errorMessage.textContent =
                            "Unable to connect to the server. Please try again.";


                    } finally {

                        // Enable button again
                        loginButton.disabled = false;

                        loginButton.textContent =
                            "Login";
                    }

                }
            );


            // ----------------------------------
            // Show Dashboard
            // ----------------------------------

            function showDashboard(data) {

                // Username
                username.textContent =
                    data.username || "User";


                dashboardUsername.textContent =
                    data.username || "-";


                // Phone
                dashboardPhone.textContent =
                    data.phoneNumber || "-";


                // Balance
                balance.textContent =
                    formatBalance(data.balance);


                // Hide login
                loginPage.classList.add("hidden");


                // Show dashboard
                dashboardPage.classList.remove("hidden");
            }


            // ----------------------------------
            // Format Balance
            // ----------------------------------

            function formatBalance(value) {

                const amount =
                    Number(value);


                if (isNaN(amount)) {

                    return "0.00";
                }


                return amount.toFixed(2);
            }


            // ----------------------------------
            // Logout
            // ----------------------------------

            logoutButton.addEventListener(
                "click",
                function() {

                    // Hide dashboard
                    dashboardPage.classList.add(
                        "hidden"
                    );


                    // Show login
                    loginPage.classList.remove(
                        "hidden"
                    );


                    // Clear form
                    loginForm.reset();


                    // Clear error
                    errorMessage.textContent = "";
                }
            );

    </script>

</body>
</html>