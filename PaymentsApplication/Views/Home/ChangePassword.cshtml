@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
        }

        .login-box {
            width: 350px;
            margin: 100px auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
            text-align: center;
        }

        input {
            width: 90%;
            padding: 10px;
            margin: 10px 0;
            font-size: 16px;
        }

        button {
            width: 95%;
            padding: 10px;
                background-color: #2B5748;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
            border-radius: 5px;
        }

            button:hover {
                    background-color: #9CB080;
            }

        .register-link {
            margin-top: 15px;
        }

            .register-link a {
                color: #007bff;
                text-decoration: none;
            }

            .back_button {
                background-color: orange;
                margin-top: 15px;
            }

                .back_button:hover {
                    background-color: darkorange;
                }
    </style>
</head>

<body>

    <div class="login-box">
        <h2>Change Password</h2>

        <form asp-controller="Home" asp-action="ChangePassword" method="post">
            
            <input type="text" name="PhoneNumber" placeholder="Phone Number" minlength="11"
                   maxlength="11" pattern="[0-9]{11}" required />
            <input type="password" name="CurrentPassword" placeholder="current Password" required />
            <input type="password" name="NewPassword" placeholder="New Password" required />
            <input type="password" name="ConfirmNewPassword" placeholder="Confirm the new password" required />
            <button type="submit">Submit</button>

        </form>
        <form method="post">
            <p>
                <button type="submit"
                        class="buttons_db back_button"
                        asp-controller="Home"
                        asp-action="DashboardPage">
                    Back

                </button>
            </p>
        </form>

        

        <h3>@ViewBag.ChangePasswordResponse</h3>
    </div>

</body>
</html>