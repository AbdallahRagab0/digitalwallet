@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
        }

        .login-box {
            width: 350px;
            margin: 100px auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
            text-align: center;
        }

        input {
            width: 90%;
            padding: 10px;
            margin: 10px 0;
            font-size: 16px;
        }

        button {
            width: 95%;
            padding: 10px;
                background-color: #2B5748;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
            border-radius: 5px;
        }

            button:hover {
                    background-color: #9CB080;
            }

        .register-link {
            margin-top: 15px;
        }

            .register-link a {
                color: #007bff;
                text-decoration: none;
            }
            .back_button {
                background-color: orange;
                margin-top: 15px;
            }

                .back_button:hover {
                    background-color: darkorange;
                }


            
    </style>
</head>

<body>
    
    <div class="login-box">
        <h2>Add money</h2>
        <h5>your currunt balance: @ViewBag.UserBalance </h5>
        <form asp-controller="Home" asp-action="AddMoney" method="post">

            @* <input type="number" name="PhoneNumber" placeholder="Phone Number" required /> *@
            <input type="number" name="Amount" placeholder="Amount" min="1" step="0.01" />
            <button type="submit">Submit</button>

        </form>
        
        <form method="post">
            <p>
                <button type="submit"
                        class="buttons_db back_button"
                        asp-controller="Home"
                        asp-action="DashboardPage">
                    Back
                    
                </button>
            </p>
        </form>
        
        <h3>@ViewBag.AddMoneyResponse</h3>
    </div>

</body>
</html>