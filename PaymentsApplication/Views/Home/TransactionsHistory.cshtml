@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
        }

        .login-box {
            width: 1100px;
            margin: 100px auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
            text-align: center;
        }

        input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            font-size: 16px;
        }

        button {
            width: 100%;
            padding: 10px;
                background-color: #2B5748;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
            border-radius: 5px;
        }

            button:hover {
                    background-color: #9CB080;
            }

        .register-link {
            margin-top: 15px;
        }

            .register-link a {
                color: #007bff;
                text-decoration: none;
				}

			table {
				font-family: arial, sans-serif;
				border-collapse: collapse;
				width: 100%;
			}

			td, th {
				border: 1px solid #dddddd;
				text-align: left;
				padding: 8px;
			}

			tr:nth-child(even) {
				background-color: #dddddd;
			}

            .back_button {
                background-color: orange;
                margin-top: 15px;
            }

                .back_button:hover {
                    background-color: darkorange;
                }
    </style>
</head>

<body>

    <div class="login-box">
        <h2>Transactions History</h2>

        
        <form asp-controller="Home" asp-action="DisplayTransactionsHistoryFromDate" method="post">

            <br />
            
            
            <input type="date" name="TransactionStartDate" placeholder="from" required />
            <input type="date" name="TransactionEndDate" placeholder="to" required />
            <br />
            <button type="submit">Search</button>

        </form>
        @ViewBag.AddMoneyResponse
        @if (ViewBag.AllTransactions != null)
            {

            <br />
            <br />
            <table>
                <tr>

                    <th>Sender ID</th>
                    <th>receiver ID</th>
                    <th>Sender phone number</th>
                    <th>receiver phone number</th>
                    <th>amount</th>
                    <th>transaction type</th>
                    <th>transaction date</th>
                </tr>

                
                @foreach (var item in ViewBag.AllTransactions)
                {
                    <tr>
                        <td>@item.SenderId</td>
                        <td>@item.ReceiverId</td>
                        <td>@item.SenderPhoneNumber</td>
                        <td>@item.ReceiverPhoneNumber</td>
                        <td>@item.Amount</td>
                        <td>@item.TransactionType</td>
                        <td>@item.TransactionDate</td>
                    </tr>
                }

            </table>
            }

            <br />
            <br />

        <form method="post">
            <p>
                <button type="submit"
                        class="buttons_db back_button"
                        asp-controller="Home"
                        asp-action="DashboardPage">
                    Back

                </button>
            </p>
        </form>
    </div>

</body>
</html>