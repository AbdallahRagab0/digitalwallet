@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
        }

        .login-box {
            width: 350px;
            margin: 100px auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
            text-align: center;
        }

        input {
            width: 90%;
            padding: 10px;
            margin: 10px 0;
            font-size: 16px;
        }

        button {
            width: 95%;
            padding: 10px;
                background-color: #2B5748;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
            border-radius: 5px;
        }

            button:hover {
                    background-color: #9CB080;
            }

        .register-link {
            margin-top: 15px;
        }

            .register-link a {
                color: #007bff;
                text-decoration: none;
            }

            .back_button {
                background-color: orange;
                margin-top: 15px;
            }

                .back_button:hover {
                    background-color: darkorange;
                }
    </style>
</head>

<body>

    <div class="login-box">
        <h2>Register</h2>

        <form asp-controller="Home" asp-action="register" method="post">

            <input type="text" name="PhoneNumber" placeholder="Phone Number" minlength="11"
                   maxlength="11" pattern="[0-9]{11}" required />
            <input type="text" name="UserName" placeholder="User name" required />
            <input type="email" name="UserEmail" placeholder="Email" minlength="10" maxlength="80" required/>
            <input type="password" name="Password" placeholder="Password" required />
            <input type="password" name="ConfirmPassword" placeholder="Confirm the password" required />

            <input type="number" name="Balance" placeholder="Balance" required min="1" step="0.01" "  />
            <button type="submit">Register</button>

        </form>
        <form method="post">
            <p>
                <button type="submit"
                        class="buttons_db back_button"
                        asp-controller="Home"
                        asp-action="LoginPage">
                    Back

                </button>
            </p>
        </form>


        <h3>@ViewBag.RegisterResponse</h3>
    </div>

</body>
</html>