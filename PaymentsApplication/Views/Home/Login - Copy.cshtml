@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
        }

        .login-box {
            width: 350px;
            margin: 100px auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
            text-align: center;
        }

        input {
            width: 90%;
            padding: 10px;
            margin: 10px 0;
            font-size: 16px;
        }

        button {
            width: 95%;
            padding: 10px;
                background-color: #2B5748;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
                    background-color: #9CB080;
        }

        .register-link {
            margin-top: 15px;
        }

        .register-link a {
            color: #007bff;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="login-box">
        <h2>Login</h2>

        <form asp-controller="Home" asp-action="Login" method="post">
            
            <input type="text" name="phoneNumber" placeholder="Phone Number" minlength="11"
                   maxlength="11" pattern="[0-9]{11}" required />
            <input type="password" name="password" placeholder="Password" required />
            <button type="submit">Login</button>

        </form>

        <div class="register-link">
            <p>
                
                                Don't have an account?
                <a asp-controller="Home" asp-action="RegisterPage">Register</a>
            </p>
        </div>

        <h3>@ViewBag.LoginResponse</h3>
    </div>

</body>
</html>